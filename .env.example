TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Latest stable Flash-Lite. Use gemini-3.1-flash-lite for the cheaper previous generation.
GEMINI_MODEL=gemini-3.5-flash-lite
# minimal | low | medium | high (thinking tokens are billed as output)
GEMINI_THINKING_LEVEL=minimal
# standard | flex | priority (flex is cheaper, may be slower)
GEMINI_SERVICE_TIER=standard
GEMINI_MAX_OUTPUT_TOKENS=2048

# Client-side throttling; set to your Gemini API tier limits
LLM_RPM=35
LLM_TPM=45000
# Skip page chunks that contain none of the "include" keywords
LLM_KEYWORD_GATE=true

DATABASE_URL=sqlite:///./data/seen.db
SCRAPE_HOURS=8,13,18
MAX_CHARS=12000
